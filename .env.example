# Copy to .env for local docker compose: cp .env.example .env

NODE_ENV=development
PORT=3000
APP_PORT=3000

# Docker Compose service hostnames (local)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=myuser
DB_PASSWORD=mysecretpassword
DB_DATABASE=mydatabase

# Railway private network hostnames (set these on the app service in Railway)
# DB_HOST=postgres.railway.internal
# REDIS_HOST=redis.railway.internal

DB_SYNCHRONIZE=true
DB_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change_me_to_long_random_secret

ENABLE_SWAGGER=true
SWAGGER_TITLE=Sport Equipment API
SWAGGER_DESCRIPTION=REST API for Sport Equipment E-commerce
SWAGGER_VERSION=1.0
SWAGGER_PATH=/api-docs

# Public URL of deployed API (Swagger server list)
# BASE_URL=https://your-app.up.railway.app
